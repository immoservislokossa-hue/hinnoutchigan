# ---------------------------------------------------------------------------
# Site public
# ---------------------------------------------------------------------------
# URL publique (SEO, sitemap, liens des e-mails d'invitation)
NEXT_PUBLIC_SITE_URL=https://www.example.bj

# ---------------------------------------------------------------------------
# Supabase (Project Settings > API)
# Sans ces variables, le site public fonctionne avec son contenu statique ;
# le back-office, l'espace membre et l'envoi des formulaires sont désactivés.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Clé « service_role » : SERVEUR UNIQUEMENT. Ne jamais la préfixer par NEXT_PUBLIC_.
# Sert à enregistrer les formulaires publics, inviter des comptes et signer des URL de fichiers.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Sel de hachage des adresses IP (limitation de débit des formulaires). Générer : openssl rand -hex 24
FORMS_HASH_SALT=
